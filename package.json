{
  "name": "keep-board",
  "version": "1.0.0",
  "description": "A Google Keep-style notes board for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production"
  },
  "private": true,
  "engines": { "node": ">=18" },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.5",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  }
}